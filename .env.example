# =========================================================
# GLPI - Configuração de Conexão REST API
# =========================================================
# Modo Simulação (true = usa dados de demonstração realistas; false = conecta no GLPI real)
GLPI_DEMO_MODE=true

# URL da API REST do seu GLPI (ex: https://glpi.suaempresa.com.br/apirest.php)
GLPI_API_URL=https://glpi.suaempresa.com.br/apirest.php

# Tokens de acesso do GLPI (Configurar > Geral > API e Preferências do Usuário > Chave de acesso remoto)
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# Filtro padrão de Grupo Técnico (opcional, ID ou nome do grupo no GLPI)
GLPI_DEFAULT_GROUP=TI - Geral
GLPI_VERIFY_SSL=true

# =========================================================
# Provedor de IA (LLM) para Triagem e Tratativa Prévia
# =========================================================
# Opções: gemini | openai | ollama | heuristic
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Local (Privacidade 100% na rede local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
